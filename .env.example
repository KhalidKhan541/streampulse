# ==============================================
# StreamPulse Configuration
# ==============================================
# Copy this file to .env and fill in the values

# ---- Application ----
APP_ENV=development
APP_NAME=StreamPulse
DEBUG=true
LOG_LEVEL=INFO

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_EVENTS=events.raw
KAFKA_TOPIC_ENRICHED_EVENTS=events.enriched
KAFKA_TOPIC_ALERTS=events.alerts
KAFKA_CONSUMER_GROUP=streampulse-processor
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000

# ---- PostgreSQL ----
POSTGRES_DSN=postgresql+asyncpg://streampulse:password@localhost:5432/streampulse

# ---- ClickHouse ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=streampulse

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Stream Processing ----
WINDOW_SIZE_SECONDS=60
WATERMARK_DELAY_SECONDS=30
MAX_BATCH_SIZE=1000
COMMIT_INTERVAL_SECONDS=5

# ---- Anomaly Detection ----
ANOMALY_THRESHOLD_SIGMA=3.0
ANOMALY_WINDOW_SECONDS=300
BASELINE_WINDOW_SECONDS=3600

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# ---- Monitoring ----
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30
